{
  "type": "minecraft:sequence",
  "sequence": [
    "minecraft:bedrock_floor",
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:above_preliminary_surface"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:on_floor",
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:biome",
                    "biome_is": [
                      "gloam:old_growth_pine_taiga",
                      "gloam:old_growth_spruce_taiga"
                    ]
                  },
                  "then_run": "minecraft:overworld/biome_surface/old_growth_pine_taiga"
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:biome",
                    "biome_is": [
                      "gloam:swamp",
                      "gloam:mangrove_swamp"
                    ]
                  },
                  "then_run": {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "noise": "minecraft:surface",
                      "min_threshold": -0.2,
                      "max_threshold": 2.0
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": "minecraft:mud"
                    }
                  }
                },
                "minecraft:overworld/biome_surface/default"
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": "minecraft:under_floor",
            "then_run": {
              "type": "minecraft:block",
              "result_state": "minecraft:dirt"
            }
          }
        ]
      }
    },
    "minecraft:overworld/underground"
  ]
}
